# Dependencies — Docker installs these fresh inside the image
node_modules/
.pnp/
.pnp.js

# Build output — generated during Docker build
dist/
build/
out/

# Vite cache and temporary files
.vite/
.cache/
.tmp/

# Environment files and secrets
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Test output
coverage/
.nyc_output/

# Git and editor files
.git/
.gitignore
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Docker files — not needed inside the image
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.override.yml